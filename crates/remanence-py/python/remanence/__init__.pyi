# ---------------------------------------------------------------- medium

@final
class Medium:
    """The content handle: everything a recording can answer, answers here."""

    @property
    def id(self) -> int: ...
    @property
    def is_linked(self) -> bool: ...
    @property
    def article(self) -> str: ...
    @property
    def device_type(self) -> str | None:
        """`None` for an authored blank, which assumes no device."""

    @property
    def authored_as(self) -> str | None: ...
    @property
    def path(self) -> str | None: ...
    @property
    def image_path(self) -> str | None: ...
    @property
    def image_size_bytes(self) -> int: ...
    @property
    def size(self) -> int: ...
    @property
    def mode(self) -> str: ...
    @property
    def format(self) -> str: ...
    @property
    def qcow2_version(self) -> int | None: ...
    @property
    def vdi_version(self) -> tuple[int, int] | None: ...
    @property
    def is_modified(self) -> bool: ...
    @property
    def assurance(self) -> Assurance:
        """What the open established about the evidence beneath it (P28)."""

    @property
    def geometry(self) -> Geometry:
        """What the sources beneath the medium stated about the coordinates."""

    def identify(self) -> Identification:
        """The layers of the artifact's nesting, over the image's own bytes."""

    def inspect(self) -> DiskReport:
        """The disk a format adapter presents above those layers."""

    def read_at(self, offset: int, length: int, /) -> bytes: ...
    def read_sector(self, cylinder: int, head: int, sector: int, /) -> bytes:
        """Addresses in the discovered geometry.

        Refused by name — its own `GeometryRule` set — on types whose
        recording is not sector-addressed.
        """

    def write_sector(
        self, cylinder: int, head: int, sector: int, data: bytes, /
    ) -> None:
        """Buffers until `commit`, like every other write."""

    @property
    def partition_scheme(self) -> str | None:
        """The scheme the pool was populated under, established at the load."""

    def partitions(self) -> list[Partition]: ...
    def partition(self, ordinal: int, /) -> Partition | None:
        """By the scheme's own ordinal.

        A medium recording no scheme bears the direct partition at 0.
        """

    def bitstream(self) -> C1541Bitstream:
        """Clocks the family's pulses under the profile's declared channel."""

    def bytestream(self) -> C1541Bytestream:
        """Resolves the bitstream under the family's declared group code."""

    def commit(self) -> None: ...
    def rollback(self) -> None: ...

@final
class Partition:
    """One member of the scheme, or the library's own direct composition."""

    @property
    def ordinal(self) -> int: ...
    @property
    def is_direct(self) -> bool:
        """The library's own composition of the whole content.

        Carried as provenance and never as evidence: a medium recording
        no scheme bears it at ordinal 0.
        """

    @property
    def active(self) -> bool:
        """Whether the scheme flags it active."""

    @property
    def type_byte(self) -> int | None:
        """The raw recorded value. `None` for the direct partition."""

    @property
    def type_reading(self) -> str | None:
        """What that value declares."""

    @property
    def is_claimed(self) -> bool: ...
    @property
    def placement(self) -> str: ...
    @property
    def role(self) -> str: ...
    @property
    def start_bytes(self) -> int | None: ...
    @property
    def length_bytes(self) -> int | None: ...
    @property
    def is_addressable(self) -> bool: ...
    @property
    def bears_namespace(self) -> bool: ...
    @property
    def volume_id(self) -> int | None: ...
    @property
    def issue_category(self) -> str | None: ...
    @property
    def issue(self) -> str | None: ...
    @property
    def evidence(self) -> list[str]: ...
    @property
    def provenance(self) -> str | None: ...
    def check_type(self, type_id: str, /) -> None:
        """The caller's reading, checked against the recorded byte.

        The refusal is the whole of its value: a reading the byte does
        not bear is refused naming both sides, and the direct partition
        records no type to check against.
        """

    def volume(self) -> StorageSpace | None: ...
    def filesystem(self) -> StorageSpace | None: ...
    def filesystem_as(self, id: str, /) -> StorageSpace:
        """The caller's reading where no partition type determines one."""

    def __repr__(self) -> str: ...

