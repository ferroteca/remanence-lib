# ------------------------------------------------- the .remanence flux root

@final
class FluxImage:
    """A `.remanence` artifact: the physical facts of one disk."""

    def __init__(self, path: _Path, *, cache_bytes: int | None = None) -> None: ...
    def inspect(self) -> FluxImageReport: ...
    @property
    def path(self) -> str | None: ...
    @property
    def format_id(self) -> str: ...
    @property
    def format_name(self) -> str: ...
    @property
    def access_mode(self) -> str | None: ...
    @property
    def backing_bytes(self) -> int: ...
    @property
    def resident_bytes(self) -> int: ...
    def write(self, path: _Path, /) -> FluxWriteReport: ...
    def describe_d64(self) -> D64Report:
        """Computes everything and writes nothing."""

    def write_d64(self, path: _Path, /) -> D64Report: ...
    def describe_g64(self) -> G64Report: ...
    def write_g64(self, path: _Path, /) -> G64Report: ...
    def describe_p64(self) -> P64Report: ...
    def write_p64(self, path: _Path, /) -> P64Report: ...
    def materialize_c1541_bitstream(
        self, *, cache_bytes: int | None = None
    ) -> C1541Bitstream:
        """The qualifier stays: this receiver is no c1541 type."""

    def close(self) -> None: ...
    def __enter__(self) -> FluxImage: ...
    def __exit__(self, exc_type: object, exc: object, tb: object, /) -> bool: ...
    def __repr__(self) -> str: ...

