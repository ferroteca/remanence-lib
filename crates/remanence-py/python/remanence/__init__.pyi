"""Type stubs for the Remanence Python module (S3).

The stub is the surface written down. Every class, property and verb the
module registers appears here exactly once, and a disagreement between
this file and `crates/remanence-py/src/lib.rs` is a bug in one of them —
the module is the norm, so the stub is what moves.

Values that cross the boundary as stable spellings — a format id, a
device type, an article, a rule identity — are typed `str` rather than a
`Literal` union: the claim is enumerated at runtime by `formats()`,
`device_slots()`, `partition_types()` and their kin, and freezing those
sets into the stub would put a second, staler claim beside the one the
library answers with.
"""

import os
from typing import IO, final

__version__: str

DEFAULT_CACHE_BYTES: int
"""The per-medium session cache bound a load takes when none is stated."""

class Error(Exception):
    """Every refusal the library makes (P3, P10).

    Both attributes below are set on every instance, so they are safe to
    read in an `except` block without `getattr`.
    """

    category: str
    """How to behave. Always set."""

    rule: str | None
    """Which rule of an enumerated set the input broke.

    `None` where the refusal belongs to no such set, which is the
    ordinary case rather than an omission.
    """

_OpenFile = IO[bytes] | int
"""An artifact the caller opened: a binary file object, or its descriptor.

Whoever opens owns the lock (P7) — the library checks the handle for one
thing only (may it write?) and takes no lock of its own.
"""

MediaSource = _OpenFile | FileSource | list[_OpenFile] | list[FileSource]
"""The four shapes a load's source takes.

One opened artifact, a collection of them, one `FileSource` taken from
another medium's namespace, or a collection of those. A collection is
one kind throughout: its first member says which, and a member of the
other kind is refused by name.
"""

_Path = str | os.PathLike[str]

# --------------------------------------------------------------- catalogs

def formats() -> list[tuple[str, str, list[str], bool, bool]]:
    """Every format this release claims.

    Each entry is `(id, name, device_types, takes_block_bytes,
    takes_collection)`. A format that records several device types needs
    one declared at the load; one that records a single device carries it
    already.
    """

def new_media_kinds() -> list[tuple[str, str, str, bool]]:
    """Every authored-media kind: `(id, name, article, takes_geometry)`."""

def device_slots() -> list[DeviceSlot]:
    """Every device slot a machine can be given, and the archive receiver."""

def partition_schemes() -> list[tuple[str, str]]:
    """Every partition scheme this release reads: `(id, name)`."""

def partition_types() -> list[tuple[str, str]]:
    """Every partition type a caller may declare: `(id, name)`."""

def dos_assignment_rules() -> list[DosAssignmentRule]:
    """Every DOS drive-letter assignment rule this release claims."""

def geometry_sources() -> list[str]:
    """Every source a geometry reading can be attributed to."""

def assurance_conditions() -> list[str]:
    """Every assurance condition this release claims (P3)."""

# -------------------------------------------------------------- discovery

def discover_media(path: _Path, *, writable: bool) -> Discovery:
    """Answers *what is this?* on no handle at all.

    Opens the artifact by name — so P7's mandatory denial applies in
    full — and builds no cache: no medium, no session cache, no spilled
    backing, because a cache bound is the load's declaration (P27).
    """

@final
class Discovery:
    """What an artifact turned out to be, and the claim over it.

    Consumed by `Session.load_discovery`, so nothing runs twice; reading
    a consumed discovery is refused by name.
    """

    @property
    def path(self) -> str | None: ...
    @property
    def image_path(self) -> str | None: ...
    @property
    def image_format(self) -> str: ...
    @property
    def image_format_name(self) -> str: ...
    @property
    def format(self) -> str: ...
    @property
    def article(self) -> str: ...
    @property
    def article_name(self) -> str: ...
    @property
    def accepting_devices(self) -> list[str]:
        """The device families that would take this medium."""

    @property
    def device_type(self) -> str | None:
        """The one device the format records, or `None` where it records several."""

    @property
    def device_types(self) -> list[str]: ...
    @property
    def image_size_bytes(self) -> int: ...
    @property
    def size(self) -> int: ...
    @property
    def mode(self) -> str: ...
    @property
    def assurance(self) -> Assurance: ...
    def identify(self) -> Identification: ...
    def __repr__(self) -> str: ...

# ----------------------------------------------------------- the session

@final
class Session:
    """The pool of machines (configuration) and media (state)."""

    def __init__(self) -> None: ...
    def load_media(
        self,
        source: MediaSource,
        format: str,
        *,
        device: str | None = None,
        block_bytes: int | None = None,
        cache_bytes: int | None = None,
    ) -> Medium:
        """The declared reading: one source and one concrete format.

        `device` is stated where the format records several and refused
        where it records one.
        """

    def new_media(
        self,
        kind: str,
        *,
        cylinders: int | None = None,
        heads: int | None = None,
        sectors_per_track: int | None = None,
        sector_bytes: int | None = None,
        cache_bytes: int | None = None,
    ) -> Medium:
        """Creates blank media whole — authorship, the third fact class.

        The coordinates are the author's own, for the kind whose claim
        takes them; a blank article kind takes none and refuses them.
        """

    def load_discovery(
        self, discovery: Discovery, *, cache_bytes: int | None = None
    ) -> Medium: ...
    def load_discovery_as(
        self, discovery: Discovery, device: str, *, cache_bytes: int | None = None
    ) -> Medium: ...
    @property
    def media(self) -> list[int]: ...
    def medium(self, media_id: int, /) -> Medium | None: ...
    def release_media(self, media_id: int, /) -> None:
        """The one state-destroying verb."""

    def add_machine(self, identity: str, /) -> Machine: ...
    @property
    def machines(self) -> list[str | None]: ...
    def machine(self, identity: str | None = None, /) -> Machine | None: ...
    def release_machine(self, identity: str, /) -> None: ...
    def add_device(self, device: str, *, slot: int | None = None) -> StorageDevice: ...
    def add_device_for(
        self, path: _Path, *, writable: bool, cache_bytes: int | None = None
    ) -> StorageDevice: ...
    @property
    def devices(self) -> list[str]: ...
    def device(self, attachment: str, /) -> StorageDevice | None: ...
    def release_device(self, attachment: str, /) -> None: ...
    def __enter__(self) -> Session: ...
    def __exit__(self, exc_type: object, exc: object, tb: object, /) -> bool: ...

