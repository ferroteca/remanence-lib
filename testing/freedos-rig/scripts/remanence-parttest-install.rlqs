#
# FIRST DRAFT (T6): the partitioning sequence and several prompt texts
# below need live convergence against the LiveCD in reliquary's driving
# loop before this produces its first artifact. The FDISK switches are
# FreeDOS's documented non-interactive forms, preferred here precisely
# so the flow stays scriptable.

description "FreeDOS 1.4 onto multiple primaries + extended/logicals, for remanence-lib"
platform    dos
machine     stopped
entry       startup
timeout     30s
deadline    45m

phase startup {
    insert cdrom0 @freedos-livecd
    start
    goto cd-boot
}

# Boot the LiveCD into its live DOS environment rather than the guided
# installer: the guided path owns the whole disk, and this rig needs a
# deliberate layout first.
phase cd-boot {
    wait   "Welcome to FreeDOS 1.4 (LiveCD)"
    select "Return to DOS"          # to-converge: exact menu wording
    wait   "C:\>"                   # LiveCD shell prompt; drive letter
                                    # to-converge (RAM drive may differ)
    goto partitioning
}

# Two primaries, one extended carrying two logicals. Sizes in MB; type
# selection is FDISK's own by size (FAT12/FAT16 under these bounds).
phase partitioning timeout=2m {
    enter "fdisk /pri:16"
    wait  "C:\>"
    enter "fdisk /pri:12"
    wait  "C:\>"
    enter "fdisk /ext:32"
    wait  "C:\>"
    enter "fdisk /log:16"
    wait  "C:\>"
    enter "fdisk /log:12"
    wait  "C:\>"
    enter "fdisk /activate:1"
    wait  "C:\>"
    # The new table is read at boot; reboot back into the LiveCD shell.
    enter "fdapm warmboot"          # to-converge: reboot verb
    goto cd-reboot
}

phase cd-reboot {
    wait   "Welcome to FreeDOS 1.4 (LiveCD)"
    select "Return to DOS"
    wait   "C:\>"
    goto formatting
}

# Format every volume with a distinct label, then drop marker files so
# the remanence tests can verify content per volume.
phase formatting timeout=10m {
    enter "format c: /q /z:seriously /v:RMNPRI1"
    wait  "C:\>"                    # to-converge: format confirmations
    enter "format d: /q /z:seriously /v:RMNPRI2"
    wait  "C:\>"
    enter "format e: /q /z:seriously /v:RMNLOG1"
    wait  "C:\>"
    enter "format f: /q /z:seriously /v:RMNLOG2"
    wait  "C:\>"
    enter "echo remanence marker: first primary > c:\\RMNMARK.TXT"
    wait  "C:\>"
    enter "md c:\\RMNDIR"
    wait  "C:\>"
    enter "echo remanence marker: second primary > d:\\RMNMARK.TXT"
    wait  "C:\>"
    enter "echo remanence marker: first logical > e:\\RMNMARK.TXT"
    wait  "C:\>"
    enter "echo remanence marker: second logical > f:\\RMNMARK.TXT"
    wait  "C:\>"
    goto install-dos
}

# A minimal DOS onto C: so the disk also boots — SYS from the LiveCD.
phase install-dos timeout=5m {
    enter "sys c:"
    wait  "C:\>"                    # to-converge: SYS output text
    goto shutdown
}

phase shutdown {
    enter "fdapm poweroff"
    wait  machine=stopped timeout=2m
    eject cdrom0
    finish
}
